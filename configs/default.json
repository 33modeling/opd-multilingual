{
  "name": "mlopd-default",
  "design": "docs/OPD-ACL-PAPER-DESIGN-v0.2.0.md (Part II)",
  "paths": {"data": "data/processed/processed.json", "cache": "data/cache", "runs": "runs"},
  "languages": ["en", "es", "fr", "de", "ru", "zh", "ja", "th", "sw", "bn"],
  "model_pairs": {
    "main": {"student": "Qwen/Qwen3-0.6B", "teacher": "Qwen/Qwen3-1.7B"},
    "x": {"student": "Qwen/Qwen2.5-0.5B-Instruct", "teacher": "Qwen/Qwen2.5-1.5B-Instruct",
          "note": "block X default suggested by the design (§5.3); the choice is the user's (§12.3-1)"}
  },
  "runtime": {"device": "auto", "dtype": "bfloat16", "cpu_dtype": "float32", "teacher_offload": true,
              "gradient_checkpointing": true, "vocab_chunk": 64, "max_context": 2048, "local_files_only": true,
              "sample_batch": 32, "temperature": 1.0,
              "lora": {"targets": ["q_proj", "v_proj"], "rank": 4, "alpha": 8},
              "adapter_seed_rule": "stable_seed(seed, 'adapter')"},
  "splits": {"split_seed": 20261124, "S0": 256, "F": 112, "U": 128, "pool_size": 1024},
  "seeds": {"grid": [87, 97, 117, 127], "grid_extra": [137, 147],
            "allocation": [201, 211, 221, 231, 241, 251, 261, 271],
            "washout": [301, 311, 321, 331, 341, 351, 361, 371],
            "x": [87, 97, 117, 127]},
  "train": {"lr": 1e-4, "clip": 1.0, "checkpoint_every": 16,
            "handoff": {"updates": 32, "batch": 8, "extended_updates": 48},
            "opd": {"updates": 128, "samples": 4, "max_new": 384, "segment_first": 16},
            "rl": {"updates": 128, "samples": 4, "max_new": 384, "dynamic_sampling": {"max_tries": 8, "stride": 37}},
            "sft_continue": {"updates": 128, "batch": 8},
            "opd_mask": {"first": 16, "answer_line": true},
            "allocation": {"updates": 128},
            "washout_sft": {"updates": 32, "batch": 8},
            "washout_rl": {"updates": 128}},
  "teacher_targets": {"samples": 4, "max_new": 384, "source": "teacher", "label": "mlopd-teacher-target"},
  "eval": {"samples": 4, "max_new_tokens": 512, "eval_seed": 20261201, "second_eval_seed": 20261202,
           "sets": ["mgsm", "msvamp"], "washout_sets": ["mgsm"]},
  "stage0": {"samples": 4, "max_new_tokens": 512, "label": "mlopd-stage0", "p_items": "S0",
             "latin_items": 64, "latin_positions": 16,
             "s0b_conditions": ["solve_en", "solve_native", "control_format", "control_language"],
             "s0d_tags": ["r0", "r1", "r2", "r3"]},
  "gates": {"scorer_agreement": 0.99, "p_min": 0.05, "q_min": 0.10, "verified_min": 56,
            "format_ratio": 0.8, "min_languages_for_m3": 6, "range_min": 0.15,
            "rl_sd_max_pp": 3.0, "rl_english_above_start": 3, "opd_sd_max_pp": 1.5,
            "latin_mass_gap": 0.10, "teacher_ratio_gap": 0.30, "imprint_languages_needed": 3,
            "gap_manipulation": 0.10, "gap_languages_needed": 3,
            "allocation_d_gap_pp": 6.0, "washout_sft_gap_pp": 2.0, "washout_positive_pilots": 3,
            "washout_pilot_seeds": 4, "collapse_pp": 6.0, "m3_pilot_spread_pp": 4.0, "m3_pilot_seeds": 2, "override_opd_noise_gate": false},
  "selection": {"m1_count": 4, "m4_count": 4, "m5_group": 2, "b_languages": 2, "x_languages": null},
  "langid": {"backend": "fasttext", "model_path": null},
  "queue": {"min_free_gb": 30, "parallel_blocks": false},
  "analysis": {"alpha": 0.05, "power": 0.8, "bootstrap": 10000, "permutations": 100000, "exact_max_n": 10,
               "noninferiority_margin_pp": 3.0, "seed": 20261125},
  "estimates_hours": {"note": "planning figures from design §8.1-§8.2 (English record unit costs), not results",
                      "student_generations_per_hour": 8400, "teacher_generations_per_hour": 4200,
                      "opd_128": 0.25, "rl_128": 0.2, "sft_128x8": 0.065, "sft_32x8": 0.016,
                      "eval_E": 0.27, "eval_E_mgsm": 0.135, "latin_mass": 0.1, "gate": 0.0}
}
